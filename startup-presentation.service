[Unit]
Description=Startup Presentation - React Website
Documentation=https://github.com/nextti/startup-presentation
After=network.target

[Service]
Type=simple
# Folosește root sau creează un user dedicat: useradd -r -s /bin/false webapp
User=root
WorkingDirectory=/var/www/startup-presentation

# Servește fișierele statice din folderul build pe portul 3000
# Calea către serve - verifică cu: which serve
ExecStart=/usr/local/bin/serve -s build -l 3000

# Restart automat în caz de crash
Restart=on-failure
RestartSec=10

# Variabile de mediu
Environment=NODE_ENV=production
Environment=PORT=3000

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startup-presentation

[Install]
WantedBy=multi-user.target
